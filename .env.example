# DeepSeek API（兼容 OpenAI 接口）
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Whisper 语音转写（可选，DeepSeek 不支持语音，需 OpenAI 或其他 STT）
# WHISPER_API_KEY=sk-your-openai-key
# WHISPER_API_BASE=https://api.openai.com/v1

# JWT 密钥（本地认证用，可随意设置一个复杂字符串）
JWT_SECRET=my-local-dev-secret-key-2024

# 应用端口
PORT=3000
